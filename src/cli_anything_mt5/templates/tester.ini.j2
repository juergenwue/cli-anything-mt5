; tester.ini generated by climt5 {{ generator_version }}
; {{ generated_at }}
[Tester]
Expert={{ expert }}
Symbol={{ symbol }}
Period={{ period }}
Login={{ login | default('') }}
Model={{ model | default(4) }}
ExecutionMode={{ execution_mode | default(0) }}
Optimization={{ optimization | default(0) }}
OptimizationCriterion={{ optimization_criterion | default(6) }}
FromDate={{ from_date }}
ToDate={{ to_date }}
ForwardMode={{ forward_mode | default(0) }}
ForwardDate={{ forward_date | default('') }}
Deposit={{ deposit | default(10000) }}
Currency={{ currency | default('USD') }}
ProfitInPips={{ profit_in_pips | default(0) }}
Leverage={{ leverage | default(100) }}
UseLocal={{ use_local | default(1) }}
UseRemote={{ use_remote | default(0) }}
UseCloud={{ use_cloud | default(0) }}
Visual={{ visual | default(0) }}
ReplaceReport={{ replace_report | default(1) }}
ShutdownTerminal={{ shutdown_terminal | default(1) }}
Report={{ report }}
{% if set_file %}ExpertParameters={{ set_file }}{% endif %}
