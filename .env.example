# Windows host running MT5 terminal, reachable via SSH
MT5_HOST=192.168.178.83
MT5_USER=Juergen

# MT5 installation root on the Windows host (colon form for scp compatibility)
# Example: "C:/Program Files/MT5/ICMarkets"
MT5_ROOT="C:/Program Files/MT5/ICMarkets"

# Terminal data ID hash. Leave empty to let `climt5 version-check` auto-discover
# by scanning C:/Users/*/AppData/Roaming/MetaQuotes/Terminal/*/origin.txt.
MT5_TERMINAL_ID=

# Optional overrides
# MT5_SSH_TIMEOUT=30
# MT5_SCP_TIMEOUT=60
# MT5_COMPILE_TIMEOUT=60
# MT5_TESTER_TIMEOUT=900
